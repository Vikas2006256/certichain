# ==========================================
# CERTICHAIN - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Port and Base URL
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL supported; SQLite supported for zero-setup local dev)
# Example for PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/certichain?schema=public"
# Example for SQLite (Default Local Setup):
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (Generate a secure random string in production)
JWT_SECRET="certichain-super-secret-jwt-key-change-in-production-2026-secure"
JWT_EXPIRES_IN="7d"

# Blockchain Configuration
# Hardhat Local Node: http://127.0.0.1:8545
# Sepolia: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
NEXT_PUBLIC_CHAIN_ID=31337

# Deployed Smart Contract Address (Updated automatically on deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# Relayer / University Deployer Private Key for automated server-side on-chain transactions
# (Hardhat Account #0 default test key - DO NOT USE ON MAINNET)
BLOCKCHAIN_SIGNER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Optional IPFS or Cloud Storage (e.g. Pinata or AWS S3)
IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs/"
IPFS_API_KEY=""
IPFS_API_SECRET=""
